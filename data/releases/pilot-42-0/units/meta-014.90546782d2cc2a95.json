{"schemaVersion":2,"release":"pilot-42-0","kind":"unit-meta","data":[{"id":"U.LEGACY.S05.C02.COGNITIVE","form":"cognitive development","meaningZh":"认知发展；思考与理解方式的发展","sense":"讨论儿童思考和理解逐渐变化的过程。cognitive修饰development；本课用它命名讨论主题，不从画线更直断定课程造成认知发展，也不把它与手部动作技能混成一项。","type":"chunk","tier":"core","sceneIds":["S05.C02"],"unitVersion":"pilot-17-0","detailRef":{"path":"./data/releases/pilot-42-0/units/detail-055.49dcfec85ea24853.json","sha256":"49dcfec85ea24853c7d095e6fd67669c45b08f6cb7df72a3cef83371a86699f1","bytes":82262,"kind":"unit-details","release":"pilot-42-0","schemaVersion":2}},{"id":"U.LEGACY.S05.C02.ERUDITE","form":"erudite","meaningZh":"博学的；有深厚学识的（正式）","sense":"形容词，可描述人或其作品展示出深厚学识。这里故事已把教授描述为博学；书多本身不构成判定学识的标准。放在识别层，不因其学识就把意见当成因果证据。","type":"word","tier":"recognition","sceneIds":["S05.C02"],"unitVersion":"pilot-17-0","detailRef":{"path":"./data/releases/pilot-42-0/units/detail-055.49dcfec85ea24853.json","sha256":"49dcfec85ea24853c7d095e6fd67669c45b08f6cb7df72a3cef83371a86699f1","bytes":82262,"kind":"unit-details","release":"pilot-42-0","schemaVersion":2}},{"id":"U.LEGACY.S05.C02.OVER_TIME","form":"over time","meaningZh":"随着时间推移","sense":"整块说明逐渐变化的时间范围。本课把儿童的长期变化与一次到访区分；它不保证随着时间过去就一定有好效果。不要把over按移交物件来逐词理解。","type":"chunk","tier":"core","sceneIds":["S05.C02"],"unitVersion":"pilot-17-0","detailRef":{"path":"./data/releases/pilot-42-0/units/detail-055.49dcfec85ea24853.json","sha256":"49dcfec85ea24853c7d095e6fd67669c45b08f6cb7df72a3cef83371a86699f1","bytes":82262,"kind":"unit-details","release":"pilot-42-0","schemaVersion":2}},{"id":"U.LEGACY.S05.C02.OBSERVATION","form":"one observation","meaningZh":"一次观察；一项观察所得","sense":"在本课中指看见某项具体表现所得的观察信息。它可以引出问题，不能独自排除家庭练习等其他原因；不是已完成的完整科学实验。","type":"chunk","tier":"core","sceneIds":["S05.C02"],"unitVersion":"pilot-17-0","detailRef":{"path":"./data/releases/pilot-42-0/units/detail-055.49dcfec85ea24853.json","sha256":"49dcfec85ea24853c7d095e6fd67669c45b08f6cb7df72a3cef83371a86699f1","bytes":82262,"kind":"unit-details","release":"pilot-42-0","schemaVersion":2}},{"id":"U.LEGACY.S05.C02.CAUSE","form":"cause","meaningZh":"导致；引起","sense":"本课及物动词，cause a change或cause + 名词。故事caused是过去式；否定句表示目前画作没有证明因果，不表示课程被证明完全没有作用。","type":"word","tier":"support","sceneIds":["S05.C02"],"unitVersion":"pilot-17-0","detailRef":{"path":"./data/releases/pilot-42-0/units/detail-055.49dcfec85ea24853.json","sha256":"49dcfec85ea24853c7d095e6fd67669c45b08f6cb7df72a3cef83371a86699f1","bytes":82262,"kind":"unit-details","release":"pilot-42-0","schemaVersion":2}},{"id":"U.LEGACY.S05.C02.PATIENT","form":"patient","meaningZh":"耐心的","sense":"形容词修饰guidance，描述指导者耐心帮助的方式。与诊所已有patients病人名词义分开；耐心指导是条件，不能直接当成效果已被证实。","type":"word","tier":"support","sceneIds":["S05.C02"],"unitVersion":"pilot-17-0","detailRef":{"path":"./data/releases/pilot-42-0/units/detail-055.49dcfec85ea24853.json","sha256":"49dcfec85ea24853c7d095e6fd67669c45b08f6cb7df72a3cef83371a86699f1","bytes":82262,"kind":"unit-details","release":"pilot-42-0","schemaVersion":2}},{"id":"U.LEGACY.S05.C02.NEXT_STEP","form":"talk about a next step","meaningZh":"谈一谈下一步行动","sense":"talk about后说讨论对象；a next step指一个可继续做的具体行动。这里邀请家长和孩子谈下一步，之后是否返回由家长判断，不把下一步说成命运预测。","type":"chunk","tier":"core","sceneIds":["S05.C02"],"unitVersion":"pilot-17-0","detailRef":{"path":"./data/releases/pilot-42-0/units/detail-055.49dcfec85ea24853.json","sha256":"49dcfec85ea24853c7d095e6fd67669c45b08f6cb7df72a3cef83371a86699f1","bytes":82262,"kind":"unit-details","release":"pilot-42-0","schemaVersion":2}}],"resources":[{"path":"./data/releases/pilot-42-0/units/detail-055.49dcfec85ea24853.json","sha256":"49dcfec85ea24853c7d095e6fd67669c45b08f6cb7df72a3cef83371a86699f1","bytes":82262,"kind":"unit-details","release":"pilot-42-0","schemaVersion":2}]}
