{"schemaVersion":2,"release":"pilot-40-0","kind":"dictionary-translations","data":{"a:01571363":{"examples":{"artificial flowers":"人造花。","artificial flavoring":"人工食用香料。","an artificial diamond":"一颗人造钻石。","artificial fibers":"人造纤维。","artificial sweeteners":"人工甜味剂。"}},"v:01741864":{"examples":{"Farmer Jones plowed his east field last week":"农夫琼斯上周犁了东边的田","turn the earth in the Spring":"在春天翻土"}},"n:14870078":{"examples":{}},"s:01991961":{"examples":{"pursued his own path...undeterred by lack of popular appreciation and understanding":"坚持自己的道路……并未因缺乏大众欣赏与理解而退缩"}},"n:06766190":{"examples":{"she made frequent mention of her promotion":"她频繁提到自己的晋升。","there was no mention of it":"没有提到这件事。","the speaker made several references to his wife":"发言者几次提到妻子。"}},"n:04669828":{"examples":{}},"n:04497962":{"examples":{"the tunnel reduced congestion at that intersection":"隧道缓解了那个交叉口的拥堵。"}},"n:02713594":{"examples":{}},"n:03854065":{"examples":{}},"n:04840405":{"examples":{}},"s:02177584":{"examples":{"a complicated problem":"一个复杂的问题。","complicated Middle East politics":"复杂的中东政治。"}},"n:09468604":{"examples":{}},"v:00310386":{"examples":{"The deer population in this town is thriving":"这个镇的鹿群繁衍兴旺。","business is booming":"生意兴隆。"}},"n:14818238":{"examples":{}},"a:00756091":{"examples":{"diluted alcohol":"稀释过的酒精。","a dilute solution":"稀溶液。","dilute acetic acid":"稀醋酸。"}},"r:00028797":{"examples":{"the first part was easy; the second, however, took hours":"第一部分很容易，第二部分却花了好几个小时。"}},"v:00271946":{"examples":{"The economy stabilized":"经济趋于稳定。"}},"n:00941140":{"examples":{"his approach to every problem is to draw up a list of pros and cons":"他处理每一个问题的方法，都是先列出利弊清单。","an attack on inflation":"应对通货膨胀","his plan of attack was misguided":"他的行动方案不妥。"}}},"resources":[]}
