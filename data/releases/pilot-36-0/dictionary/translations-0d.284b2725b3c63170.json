{"schemaVersion":2,"release":"pilot-36-0","kind":"dictionary-translations","data":{"n:06536853":{"examples":{"they held a public hearing on the bill":"他们就这项法案举行了一场公开听证会。"}},"v:01543731":{"examples":{"The birds perched high in the tree":"鸟停栖在树的高处。"}},"v:00597634":{"examples":{"She mastered Japanese in less than two years":"她用了不到两年就熟练掌握了日语。"}},"n:06193203":{"examples":{"he had the attitude that work was fun":"他认为工作很有趣。"}},"v:01000214":{"examples":{}},"a:00666058":{"examples":{"current events":"当前事件；时事","the current topic":"当前话题","current negotiations":"正在进行的谈判","current psychoanalytic theories":"当前的精神分析理论","the ship's current position":"船只目前的位置"}},"r:00048268":{"examples":{"he is presently our ambassador to the United Nations":"他现在是我们派驻联合国的大使","currently they live in Connecticut":"他们目前住在康涅狄格州"}},"n:04864200":{"examples":{"his determination showed in his every movement":"他每一个动作都显出决心","he is a man of purpose":"他是一个目标坚定的人"}},"v:01500873":{"examples":{"She sowed sunflower seeds":"她播下了向日葵种子"}},"n:07315790":{"examples":{}},"n:06684383":{"examples":{}},"n:07337390":{"examples":{}},"n:06031248":{"examples":{}},"n:06473563":{"examples":{"he filled out his tax form":"他填写了税务表格。"}},"n:13165815":{"examples":{}}},"resources":[]}
