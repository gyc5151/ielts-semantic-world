{"schemaVersion":2,"release":"pilot-35-0","kind":"dictionary-translations","data":{"s:01062631":{"examples":{"he was not available for comment":"当时无法联系到他请他发表评论。","he was available and willing to accompany her":"他有空，而且愿意陪她一起去。"}},"s:02548820":{"examples":{"clothes damp with perspiration":"被汗水弄湿的衣服"}},"n:13464820":{"examples":{"the development of his ideas took many years":"他的想法经过多年才逐渐发展起来。"}},"n:05121418":{"examples":{"he had a number of chores to do":"他有许多杂务要做。","the number of parameters is small":"参数数量很少。","the figure was about a thousand":"这个数字大约是一千。"}},"v:01915365":{"examples":{"The tourists moved through the town and bought up all the souvenirs;":"游客们穿行于城镇，买光了所有纪念品。","Some travelers pass through the desert":"有些旅行者穿越沙漠。"}},"r:00048138":{"examples":{}},"n:00198451":{"examples":{}},"r:00107987":{"examples":{"the snake moved gradually toward its victim":"蛇逐渐靠近它的猎物。"}},"n:06402031":{"examples":{}},"v:00637259":{"examples":{}},"a:01686439":{"examples":{"a truly original approach":"一种有独创性的做法。","with original music":"配有原创音乐。","an original mind":"具有创造力的头脑。"}}},"resources":[]}
