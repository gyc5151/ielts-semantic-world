{"schemaVersion":2,"release":"pilot-39-0","kind":"unit-meta","data":[{"id":"U.LEGACY.S04.W02.QUANTITATIVE","form":"quantitative measurements","meaningZh":"定量测量","sense":"用数量、数值和单位表示的测量；有数字仍需核实条件和仪器，不等于已经找出原因。","type":"chunk","tier":"core","sceneIds":["S04.W02"],"unitVersion":"pilot-16-0","detailRef":{"path":"./data/releases/pilot-39-0/units/detail-037.5c59f667efa2b30d.json","sha256":"5c59f667efa2b30d9e130bafa94f6ddbba21abc8eacac2a79a71ae7e1acd84e2","bytes":97862,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2}},{"id":"U.LEGACY.S04.W02.COLLATE","form":"collate","meaningZh":"汇集并整理以便对照","sense":"较正式动词，本课汇集带标签记录供对照。原记录还含校勘与不完整搭配，原样保留；整理数据义由剑桥另支持。","type":"word","tier":"recognition","sceneIds":["S04.W02"],"unitVersion":"pilot-16-0","detailRef":{"path":"./data/releases/pilot-39-0/units/detail-037.5c59f667efa2b30d.json","sha256":"5c59f667efa2b30d9e130bafa94f6ddbba21abc8eacac2a79a71ae7e1acd84e2","bytes":97862,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2}},{"id":"U.LEGACY.S04.W02.DATABASE","form":"database","meaningZh":"有组织的相关信息集合；数据库","sense":"这里把取样地点和日期留在记录中。存入数据库不使不完整记录自动变成可靠证据。","type":"word","tier":"support","sceneIds":["S04.W02"],"unitVersion":"pilot-16-0","detailRef":{"path":"./data/releases/pilot-39-0/units/detail-037.5c59f667efa2b30d.json","sha256":"5c59f667efa2b30d9e130bafa94f6ddbba21abc8eacac2a79a71ae7e1acd84e2","bytes":97862,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2}},{"id":"U.RESEARCH.DETERMINE.FIND_OUT","form":"determine","meaningZh":"通过调查查明","sense":"本课查明差异来源，不是决定选什么。to determine its source表示仍要调查，不能由不同样本直接指认责任。","type":"word","tier":"core","sceneIds":["S04.W02"],"unitVersion":"pilot-16-0","detailRef":{"path":"./data/releases/pilot-39-0/units/detail-037.5c59f667efa2b30d.json","sha256":"5c59f667efa2b30d9e130bafa94f6ddbba21abc8eacac2a79a71ae7e1acd84e2","bytes":97862,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2}},{"id":"U.RESEARCH.EVIDENCE.N","form":"evidence","meaningZh":"支持判断的事实或信息；证据","sense":"本课不可数名词，more evidence，不用an evidence。结果不同是信息，但还不足以确定来源。","type":"word","tier":"support","sceneIds":["S04.W02","S05.C02","S05.N04"],"unitVersion":"pilot-16-0","detailRef":{"path":"./data/releases/pilot-39-0/units/detail-037.5c59f667efa2b30d.json","sha256":"5c59f667efa2b30d9e130bafa94f6ddbba21abc8eacac2a79a71ae7e1acd84e2","bytes":97862,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2}},{"id":"U.RESEARCH.LIMITED_CONCLUSION","form":"We found …, but we need … to determine …","meaningZh":"报告发现，同时指出待查问题","sense":"found后报告观察结果，but后说明还缺什么及调查目的；不把谨慎套话用来掩盖已有确证。","type":"construction","tier":"core","sceneIds":["S04.W02"],"unitVersion":"pilot-16-0","detailRef":{"path":"./data/releases/pilot-39-0/units/detail-037.5c59f667efa2b30d.json","sha256":"5c59f667efa2b30d9e130bafa94f6ddbba21abc8eacac2a79a71ae7e1acd84e2","bytes":97862,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2}},{"id":"U.LEGACY.S15.W01.TIDE","form":"tide","meaningZh":"潮汐；海面周期性升降","sense":"本课海水水位的周期变化，不是人群或情绪的比喻。一个潮位下看见鸟少，不足以推出鸟总数下降。","type":"word","tier":"support","sceneIds":["S15.W01"],"unitVersion":"pilot-16-0","detailRef":{"path":"./data/releases/pilot-39-0/units/detail-037.5c59f667efa2b30d.json","sha256":"5c59f667efa2b30d9e130bafa94f6ddbba21abc8eacac2a79a71ae7e1acd84e2","bytes":97862,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2}},{"id":"U.LEGACY.S15.W01.LOW_TIDE","form":"at low tide","meaningZh":"在低潮时","sense":"本课记录海面处于低水位的时间；at表示状态。不是说河里所有地方都没有水。","type":"chunk","tier":"core","sceneIds":["S15.W01"],"unitVersion":"pilot-16-0","detailRef":{"path":"./data/releases/pilot-39-0/units/detail-037.5c59f667efa2b30d.json","sha256":"5c59f667efa2b30d9e130bafa94f6ddbba21abc8eacac2a79a71ae7e1acd84e2","bytes":97862,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2}},{"id":"U.LEGACY.S15.W01.TIDAL","form":"tidal","meaningZh":"与潮汐有关或由潮汐引起的","sense":"形容词修饰change等；本课水线变化影响可见范围，不证明动物离开整个湿地。","type":"word","tier":"recognition","sceneIds":["S15.W01"],"unitVersion":"pilot-16-0","detailRef":{"path":"./data/releases/pilot-39-0/units/detail-037.5c59f667efa2b30d.json","sha256":"5c59f667efa2b30d9e130bafa94f6ddbba21abc8eacac2a79a71ae7e1acd84e2","bytes":97862,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2}},{"id":"U.LEGACY.S15.W01.BAY","form":"bay","meaningZh":"海湾","sense":"本课海岸向内弯入的水域位置。不是月桂树、设备舱或栗色马义；用于定位河海相接处。","type":"word","tier":"core","sceneIds":["S15.W01"],"unitVersion":"pilot-16-0","detailRef":{"path":"./data/releases/pilot-39-0/units/detail-037.5c59f667efa2b30d.json","sha256":"5c59f667efa2b30d9e130bafa94f6ddbba21abc8eacac2a79a71ae7e1acd84e2","bytes":97862,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2}},{"id":"U.LEGACY.S15.W01.COAST","form":"coast","meaningZh":"海岸；沿海地带","sense":"沿海地带名词；不把它和shore当成在所有地方可互换的词。先识别地图上的较大沿海范围，不强迫三近义词同时主动输出。","type":"word","tier":"recognition","sceneIds":["S15.W01"],"unitVersion":"pilot-16-0","detailRef":{"path":"./data/releases/pilot-39-0/units/detail-037.5c59f667efa2b30d.json","sha256":"5c59f667efa2b30d9e130bafa94f6ddbba21abc8eacac2a79a71ae7e1acd84e2","bytes":97862,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2}},{"id":"U.LEGACY.S15.W01.SHORE","form":"shore","meaningZh":"水体边缘的岸","sense":"可用于海、湖或河的岸边；本课沿海水边的湿沙。coast通常限海岸，两者有重叠而非完全互斥。","type":"word","tier":"support","sceneIds":["S15.W01"],"unitVersion":"pilot-16-0","detailRef":{"path":"./data/releases/pilot-39-0/units/detail-037.5c59f667efa2b30d.json","sha256":"5c59f667efa2b30d9e130bafa94f6ddbba21abc8eacac2a79a71ae7e1acd84e2","bytes":97862,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2}},{"id":"U.LEGACY.S15.W01.SEAWEED","form":"seaweed","meaningZh":"海藻；海中生长的藻类等","sense":"本课托盘上的海藻，日常常不可数。原中文海草保持；科学语境seagrass和seaweed不是同一个分类。","type":"word","tier":"recognition","sceneIds":["S15.W01"],"unitVersion":"pilot-16-0","detailRef":{"path":"./data/releases/pilot-39-0/units/detail-037.5c59f667efa2b30d.json","sha256":"5c59f667efa2b30d9e130bafa94f6ddbba21abc8eacac2a79a71ae7e1acd84e2","bytes":97862,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2}},{"id":"U.LEGACY.S15.W01.INVERTEBRATE","form":"invertebrate","meaningZh":"无脊椎动物","sense":"本课名词，小动物角色；原资料还列形容词。先理解壳内是动物，而非凭壳形判断具体物种。","type":"word","tier":"recognition","sceneIds":["S15.W01"],"unitVersion":"pilot-16-0","detailRef":{"path":"./data/releases/pilot-39-0/units/detail-037.5c59f667efa2b30d.json","sha256":"5c59f667efa2b30d9e130bafa94f6ddbba21abc8eacac2a79a71ae7e1acd84e2","bytes":97862,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2}},{"id":"U.LEGACY.S15.W01.ORGANISM","form":"organism","meaningZh":"生物体","sense":"本课活的个体，不是空壳或社会机构的比喻。移动纠正了“壳是空的”初步判断。","type":"word","tier":"core","sceneIds":["S15.W01"],"unitVersion":"pilot-16-0","detailRef":{"path":"./data/releases/pilot-39-0/units/detail-037.5c59f667efa2b30d.json","sha256":"5c59f667efa2b30d9e130bafa94f6ddbba21abc8eacac2a79a71ae7e1acd84e2","bytes":97862,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2}},{"id":"U.OBSERVATION.COMPARABLE","form":"comparable","meaningZh":"适合进行比较的","sense":"能比较不要求所有条件完全相同，但与研究问题有关的潮位、时间、天气等差别必须考虑。","type":"word","tier":"core","sceneIds":["S15.W01"],"unitVersion":"pilot-16-0","detailRef":{"path":"./data/releases/pilot-39-0/units/detail-037.5c59f667efa2b30d.json","sha256":"5c59f667efa2b30d9e130bafa94f6ddbba21abc8eacac2a79a71ae7e1acd84e2","bytes":97862,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2}},{"id":"U.LEGACY.S15.W01.FEEDING","form":"the feeding area","meaningZh":"觅食区","sense":"本课鸟寻找食物的地方，不表示有人在喂鸟。被水覆盖影响可见鸟群的位置和观察条件。","type":"chunk","tier":"support","sceneIds":["S15.W01"],"unitVersion":"pilot-16-0","detailRef":{"path":"./data/releases/pilot-39-0/units/detail-037.5c59f667efa2b30d.json","sha256":"5c59f667efa2b30d9e130bafa94f6ddbba21abc8eacac2a79a71ae7e1acd84e2","bytes":97862,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2}},{"id":"U.LEGACY.S15.W02.BREEDING","form":"breeding","meaningZh":"动物交配并产生后代的繁殖活动","sense":"本课繁殖行为名词；原中文养育过宽，不能当成人类教养义。看见两只鸟靠近巢不独自证实所有繁殖阶段。","type":"word","tier":"recognition","sceneIds":["S15.W02"],"unitVersion":"pilot-16-0","detailRef":{"path":"./data/releases/pilot-39-0/units/detail-037.5c59f667efa2b30d.json","sha256":"5c59f667efa2b30d9e130bafa94f6ddbba21abc8eacac2a79a71ae7e1acd84e2","bytes":97862,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2}},{"id":"U.LEGACY.S15.W02.REPRODUCTION","form":"reproduction","meaningZh":"产生后代的生物繁殖过程","sense":"生物过程名词，不是复制图片或文本。原课说幼鸟存活仍未知；本课观察者还不能判定这次繁殖结果。","type":"word","tier":"recognition","sceneIds":["S15.W02"],"unitVersion":"pilot-16-0","detailRef":{"path":"./data/releases/pilot-39-0/units/detail-037.5c59f667efa2b30d.json","sha256":"5c59f667efa2b30d9e130bafa94f6ddbba21abc8eacac2a79a71ae7e1acd84e2","bytes":97862,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2}},{"id":"U.LEGACY.S15.W02.SEASONAL","form":"seasonal","meaningZh":"季节性的；与某季节有关的","sense":"本课记录只来自春季，需其他时段观察。seasonal不表示已经有多年记录。","type":"word","tier":"core","sceneIds":["S15.W02"],"unitVersion":"pilot-16-0","detailRef":{"path":"./data/releases/pilot-39-0/units/detail-037.5c59f667efa2b30d.json","sha256":"5c59f667efa2b30d9e130bafa94f6ddbba21abc8eacac2a79a71ae7e1acd84e2","bytes":97862,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2}},{"id":"U.LEGACY.S15.W02.MIGRATION","form":"migration","meaningZh":"动物周期性迁徙","sense":"本课地图上的鸟类迁徙，不是人口移居或分子内部迁移。一次看见鸟不确定它完整走过的路线。","type":"word","tier":"support","sceneIds":["S15.W02"],"unitVersion":"pilot-16-0","detailRef":{"path":"./data/releases/pilot-39-0/units/detail-037.5c59f667efa2b30d.json","sha256":"5c59f667efa2b30d9e130bafa94f6ddbba21abc8eacac2a79a71ae7e1acd84e2","bytes":97862,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2}},{"id":"U.LEGACY.S15.W02.PERCH","form":"perch","meaningZh":"停栖在枝条等支撑物上","sense":"本课鸟类动词，常用perch on；故事perched是过去式。不是鲈鱼、栖木名词或旧长度单位。","type":"word","tier":"support","sceneIds":["S15.W02"],"unitVersion":"pilot-16-0","detailRef":{"path":"./data/releases/pilot-39-0/units/detail-037.5c59f667efa2b30d.json","sha256":"5c59f667efa2b30d9e130bafa94f6ddbba21abc8eacac2a79a71ae7e1acd84e2","bytes":97862,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2}},{"id":"U.LEGACY.S15.W02.ISLAND","form":"island","meaningZh":"四周被水包围的陆地；岛","sense":"本课地图和标杆所指的小岛。不是道路中间的安全岛等比喻用法。","type":"word","tier":"recognition","sceneIds":["S15.W02"],"unitVersion":"pilot-16-0","detailRef":{"path":"./data/releases/pilot-39-0/units/detail-037.5c59f667efa2b30d.json","sha256":"5c59f667efa2b30d9e130bafa94f6ddbba21abc8eacac2a79a71ae7e1acd84e2","bytes":97862,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2}},{"id":"U.LEGACY.S15.W02.ROPE","form":"behind the rope","meaningZh":"留在绳索后方","sense":"本课游客边界的位置表达；视线可以望向巢，不越过标示的边界。","type":"chunk","tier":"core","sceneIds":["S15.W02"],"unitVersion":"pilot-16-0","detailRef":{"path":"./data/releases/pilot-39-0/units/detail-037.5c59f667efa2b30d.json","sha256":"5c59f667efa2b30d9e130bafa94f6ddbba21abc8eacac2a79a71ae7e1acd84e2","bytes":97862,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2}},{"id":"U.LEGACY.S15.W02.DISTURB","form":"avoid disturbing …","meaningZh":"避免打扰某对象","sense":"avoid后用动词-ing；本课说明距离规则保护巢区的目的，不把照片需要当成越界理由。","type":"chunk","tier":"core","sceneIds":["S15.W02"],"unitVersion":"pilot-16-0","detailRef":{"path":"./data/releases/pilot-39-0/units/detail-037.5c59f667efa2b30d.json","sha256":"5c59f667efa2b30d9e130bafa94f6ddbba21abc8eacac2a79a71ae7e1acd84e2","bytes":97862,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2}},{"id":"U.LEGACY.S15.W02.LIMIT","form":"We have seen …, but we do not yet know whether …","meaningZh":"区分观察到的行为与未知结果","sense":"have seen给已经观察的事实；not yet know whether给未知问题。不会因为看见巢边两只鸟就预测幼鸟必定存活。","type":"construction","tier":"core","sceneIds":["S15.W02"],"unitVersion":"pilot-16-0","detailRef":{"path":"./data/releases/pilot-39-0/units/detail-037.5c59f667efa2b30d.json","sha256":"5c59f667efa2b30d9e130bafa94f6ddbba21abc8eacac2a79a71ae7e1acd84e2","bytes":97862,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2}},{"id":"U.LEGACY.S15.W02.EVEN_IF","form":"… even if it means …","meaningZh":"提出可行方案并承认代价","sense":"even if引出即使需要承担的代价；means后可以用-ing说明后果。本课更远拍照是守边界的代价。","type":"construction","tier":"core","sceneIds":["S15.W02"],"unitVersion":"pilot-16-0","detailRef":{"path":"./data/releases/pilot-39-0/units/detail-037.5c59f667efa2b30d.json","sha256":"5c59f667efa2b30d9e130bafa94f6ddbba21abc8eacac2a79a71ae7e1acd84e2","bytes":97862,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2}},{"id":"U.LEGACY.S03.G01.DOWNTOWN","form":"downtown","meaningZh":"市中心的","sense":"本课形容词，修饰square，说明城市中心区域的位置；不把这里的定语用法当成go downtown的副词用法。","type":"word","tier":"recognition","sceneIds":["S03.G01","S03.G02"],"unitVersion":"pilot-17-0","detailRef":{"path":"./data/releases/pilot-39-0/units/detail-038.c3e78ee86740d302.json","sha256":"c3e78ee86740d302be01051cf1153ff2f7296a02ff9f9f123502ed08e04fdcf9","bytes":96120,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2}},{"id":"U.LEGACY.S03.G01.ESTATE","form":"estate","meaningZh":"一大片私有土地；庄园","sense":"本课土地名词，旧地图说明广场用地曾是一处私有庄园的一部分；不采用遗产总额义，也不把estate agent整块当作这个词的同义表达。","type":"word","tier":"recognition","sceneIds":["S03.G01"],"unitVersion":"pilot-17-0","detailRef":{"path":"./data/releases/pilot-39-0/units/detail-038.c3e78ee86740d302.json","sha256":"c3e78ee86740d302be01051cf1153ff2f7296a02ff9f9f123502ed08e04fdcf9","bytes":96120,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2}},{"id":"U.LEGACY.S03.G01.SITE","form":"site","meaningZh":"所在地；场地","sense":"本课土地或场地名词，指广场所在的实际地点，也可迁移到新图书馆场地；不选网站名词或选址动词。","type":"word","tier":"support","sceneIds":["S03.G01"],"unitVersion":"pilot-17-0","detailRef":{"path":"./data/releases/pilot-39-0/units/detail-038.c3e78ee86740d302.json","sha256":"c3e78ee86740d302be01051cf1153ff2f7296a02ff9f9f123502ed08e04fdcf9","bytes":96120,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2}},{"id":"U.LEGACY.S03.G01.CIRCULAR","form":"circular","meaningZh":"圆形的","sense":"本课形状形容词，描述花园轮廓。原R01121还列循环的中文，但圆桌例句支持圆形义；不把花园形状当成循环过程。","type":"word","tier":"recognition","sceneIds":["S03.G01","S03.G02"],"unitVersion":"pilot-17-0","detailRef":{"path":"./data/releases/pilot-39-0/units/detail-038.c3e78ee86740d302.json","sha256":"c3e78ee86740d302be01051cf1153ff2f7296a02ff9f9f123502ed08e04fdcf9","bytes":96120,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2}},{"id":"U.LEGACY.S03.G01.POSTS","form":"posts","meaningZh":"竖立的柱杆（复数）","sense":"本课名词复数，木制柱杆立在花园边缘；单数是post。不是职位、网上帖子或邮寄动作，任务不要求罗列这些无关义。","type":"word","tier":"support","sceneIds":["S03.G01","S03.G02"],"unitVersion":"pilot-17-0","detailRef":{"path":"./data/releases/pilot-39-0/units/detail-038.c3e78ee86740d302.json","sha256":"c3e78ee86740d302be01051cf1153ff2f7296a02ff9f9f123502ed08e04fdcf9","bytes":96120,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2}},{"id":"U.LEGACY.S03.G01.ENTRANCE","form":"entrance","meaningZh":"进入某处的入口","sense":"本课地点名词，指可进入花园的位置；可以由一扇gate提供入口，但两词侧重点不同。不是进场行为或使人着迷的动词。","type":"word","tier":"core","sceneIds":["S03.G01","S03.G02"],"unitVersion":"pilot-17-0","detailRef":{"path":"./data/releases/pilot-39-0/units/detail-038.c3e78ee86740d302.json","sha256":"c3e78ee86740d302be01051cf1153ff2f7296a02ff9f9f123502ed08e04fdcf9","bytes":96120,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2}},{"id":"U.LEGACY.S03.G01.GATE","form":"gate","meaningZh":"围墙或栅栏上可开关的门","sense":"本课实体门名词，模型中门朝向道路；entrance说明入口位置，gate说明可开关的门。原故事未提供门的尺寸，不擅自补尺寸。","type":"word","tier":"support","sceneIds":["S03.G01","S03.G02"],"unitVersion":"pilot-17-0","detailRef":{"path":"./data/releases/pilot-39-0/units/detail-038.c3e78ee86740d302.json","sha256":"c3e78ee86740d302be01051cf1153ff2f7296a02ff9f9f123502ed08e04fdcf9","bytes":96120,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2}},{"id":"U.LEGACY.S03.G01.ASK_WAY","form":"Which way is …?","meaningZh":"……往哪边走？","sense":"到达公交站后用which way询问目的地的方向；is后填地点名称。本课是原创问路句型，来源entrance记录只支持入口名词。","type":"construction","tier":"core","sceneIds":["S03.G01"],"unitVersion":"pilot-17-0","detailRef":{"path":"./data/releases/pilot-39-0/units/detail-038.c3e78ee86740d302.json","sha256":"c3e78ee86740d302be01051cf1153ff2f7296a02ff9f9f123502ed08e04fdcf9","bytes":96120,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2}},{"id":"U.LEGACY.S03.G01.GET_THROUGH","form":"get through with a pram","meaningZh":"推着婴儿车通过","sense":"本课空间通行组合，with a pram表示带着婴儿车，不把整块误读为get through with something的完成某事义。实际障碍是货车留下的窄缝；并非门本身必然过窄。","type":"chunk","tier":"core","sceneIds":["S03.G01"],"unitVersion":"pilot-17-0","detailRef":{"path":"./data/releases/pilot-39-0/units/detail-038.c3e78ee86740d302.json","sha256":"c3e78ee86740d302be01051cf1153ff2f7296a02ff9f9f123502ed08e04fdcf9","bytes":96120,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2}},{"id":"U.LEGACY.S03.G02.SOUNDSCAPE","form":"soundscape","meaningZh":"某处各种声音构成的整体；声景","sense":"本课地点声音名词，关注公交车、货车与树叶等声音在所处地点的组合，不只是音量。原记录直接支持环境声音义；Oxford组合声音定义较宽，WordNet当前没有本词义项。","type":"word","tier":"core","sceneIds":["S03.G02"],"unitVersion":"pilot-17-0","detailRef":{"path":"./data/releases/pilot-39-0/units/detail-038.c3e78ee86740d302.json","sha256":"c3e78ee86740d302be01051cf1153ff2f7296a02ff9f9f123502ed08e04fdcf9","bytes":96120,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2}},{"id":"U.LEGACY.S03.G02.QUIET","form":"quiet","meaningZh":"声音少的；安静的","sense":"本课声音形容词；quieter是比较级，说明相对另一侧声音较少。quiet不总要求完全没有声音；不选沉默寡言或商业清淡义。","type":"word","tier":"support","sceneIds":["S03.G02"],"unitVersion":"pilot-17-0","detailRef":{"path":"./data/releases/pilot-39-0/units/detail-038.c3e78ee86740d302.json","sha256":"c3e78ee86740d302be01051cf1153ff2f7296a02ff9f9f123502ed08e04fdcf9","bytes":96120,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2}},{"id":"U.LEGACY.S03.G02.SILENT","form":"silent","meaningZh":"无声的；没有声音的","sense":"本课无声形容词，作为quiet的语义边界用于识别；树叶仍发出声音，因此较安静不等于无声。不强迫建议时把两个形容词并排输出。","type":"word","tier":"recognition","sceneIds":["S03.G02"],"unitVersion":"pilot-17-0","detailRef":{"path":"./data/releases/pilot-39-0/units/detail-038.c3e78ee86740d302.json","sha256":"c3e78ee86740d302be01051cf1153ff2f7296a02ff9f9f123502ed08e04fdcf9","bytes":96120,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2}},{"id":"U.LEGACY.S03.G02.DURING","form":"during our visit","meaningZh":"在我们实地查看期间","sense":"用during限定观察所对应的时间段；our visit可随人称改变，不把一次安静的情况说成永久保证。此时间边界来自旧故事与任务需要。","type":"chunk","tier":"core","sceneIds":["S03.G02"],"unitVersion":"pilot-17-0","detailRef":{"path":"./data/releases/pilot-39-0/units/detail-038.c3e78ee86740d302.json","sha256":"c3e78ee86740d302be01051cf1153ff2f7296a02ff9f9f123502ed08e04fdcf9","bytes":96120,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2}},{"id":"U.LEGACY.S03.G02.RECOMMEND","form":"I would put … because …","meaningZh":"我会把……放在……，因为……","sense":"would put后说明具体物件与地点，because后给与放置目的有关的观察依据；本课建议座位靠墙，不以复杂声景名词代替具体理由。","type":"construction","tier":"core","sceneIds":["S03.G02"],"unitVersion":"pilot-17-0","detailRef":{"path":"./data/releases/pilot-39-0/units/detail-038.c3e78ee86740d302.json","sha256":"c3e78ee86740d302be01051cf1153ff2f7296a02ff9f9f123502ed08e04fdcf9","bytes":96120,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2}},{"id":"U.LEGACY.S03.G02.CHECK_WHEN","form":"Could we check … when …?","meaningZh":"我们能在……时再检查……吗？","sense":"用could we提出共同核实的请求，when后给需要比较的条件。道路繁忙时再查看是补充观察，不意味着本次安静已经失效。","type":"construction","tier":"core","sceneIds":["S03.G02"],"unitVersion":"pilot-17-0","detailRef":{"path":"./data/releases/pilot-39-0/units/detail-038.c3e78ee86740d302.json","sha256":"c3e78ee86740d302be01051cf1153ff2f7296a02ff9f9f123502ed08e04fdcf9","bytes":96120,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2}},{"id":"U.LEGACY.S03.G02.ROOM","form":"room","meaningZh":"可供通行或活动的空间","sense":"本课不可数空间名词，more room说明可用空间更多，不是更多房间。故事只说图纸移动了入口，没有提供通行宽度的测量。","type":"word","tier":"support","sceneIds":["S03.G02"],"unitVersion":"pilot-17-0","detailRef":{"path":"./data/releases/pilot-39-0/units/detail-038.c3e78ee86740d302.json","