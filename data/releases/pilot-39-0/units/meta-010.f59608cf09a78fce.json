ersion":2}},{"id":"U.LEGACY.S11.A01.CANDOUR","form":"candour","meaningZh":"坦率；真诚直言","sense":"英式拼写candour，美式candor。本课说明她诚实说出自己的意愿，不要求弱基础学习者用此抽象名词作拒绝。","type":"word","tier":"recognition","sceneIds":["S11.A01"],"unitVersion":"pilot-17-0","detailRef":{"path":"./data/releases/pilot-39-0/units/detail-038.c3e78ee86740d302.json","sha256":"c3e78ee86740d302be01051cf1153ff2f7296a02ff9f9f123502ed08e04fdcf9","bytes":96120,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2}},{"id":"U.LEGACY.S11.A01.CONFIDANT","form":"confidant","meaningZh":"可倾诉私事的知己","sense":"本课坐在旁边、值得信任的志愿者。confidant名词与confident自信的形容词不同；知己不代替本人作决定。","type":"word","tier":"recognition","sceneIds":["S11.A01"],"unitVersion":"pilot-17-0","detailRef":{"path":"./data/releases/pilot-39-0/units/detail-038.c3e78ee86740d302.json","sha256":"c3e78ee86740d302be01051cf1153ff2f7296a02ff9f9f123502ed08e04fdcf9","bytes":96120,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2}},{"id":"U.LEGACY.S11.A01.RESENT","form":"resent","meaningZh":"对……感到怨愤；介意不公平的对待","sense":"resent + 名词或doing，例句用被动being shown。可以先用do not want表达意愿，再识别较强的resent。","type":"word","tier":"support","sceneIds":["S11.A01"],"unitVersion":"pilot-17-0","detailRef":{"path":"./data/releases/pilot-39-0/units/detail-038.c3e78ee86740d302.json","sha256":"c3e78ee86740d302be01051cf1153ff2f7296a02ff9f9f123502ed08e04fdcf9","bytes":96120,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2}},{"id":"U.LEGACY.S11.A01.TREATMENT","form":"treatment","meaningZh":"对待某人的方式","sense":"本课邻里之间怎样对待一个人，不是医疗治疗。名词the treatment of someone。","type":"word","tier":"support","sceneIds":["S11.A01"],"unitVersion":"pilot-17-0","detailRef":{"path":"./data/releases/pilot-39-0/units/detail-038.c3e78ee86740d302.json","sha256":"c3e78ee86740d302be01051cf1153ff2f7296a02ff9f9f123502ed08e04fdcf9","bytes":96120,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2}},{"id":"U.PERMISSION.ASK","form":"ask for permission","meaningZh":"征求许可","sense":"先明确要做什么，再让本人作选择。询问并不代表已获同意；