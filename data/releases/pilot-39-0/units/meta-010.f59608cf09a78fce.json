1.A02"],"unitVersion":"pilot-17-0","detailRef":{"path":"./data/releases/pilot-39-0/units/detail-038.c3e78ee86740d302.json","sha256":"c3e78ee86740d302be01051cf1153ff2f7296a02ff9f9f123502ed08e04fdcf9","bytes":96120,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2}},{"id":"U.LEGACY.S11.A02.HUMILITY","form":"humility","meaningZh":"谦逊；不自大","sense":"本课阿莎愿意接受批评的态度。识别层，不强迫与modesty同时输出；具体说I missed a step更易调用。","type":"word","tier":"recognition","sceneIds":["S11.A02"],"unitVersion":"pilot-17-0","detailRef":{"path":"./data/releases/pilot-39-0/units/detail-038.c3e78ee86740d302.json","sha256":"c3e78ee86740d302be01051cf1153ff2f7296a02ff9f9f123502ed08e04fdcf9","bytes":96120,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2}},{"id":"U.LEGACY.S11.A02.MODESTY","form":"modesty","meaningZh":"谦虚；不夸耀自己","sense":"本课梅太太受到称赞后没有夸大自己的贡献。与humility有语义重叠，此处按不同互动识别，不教学成完全互斥。","type":"word","tier":"recognition","sceneIds":["S11.A02"],"unitVersion":"pilot-17-0","detailRef":{"path":"./data/releases/pilot-39-0/units/detail-038.c3e78ee86740d302.json","sha256":"c3e78ee86740d302be01051cf1153ff2f7296a02ff9f9f123502ed08e04fdcf9","bytes":96120,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2}},{"id":"U.LEGACY.S11.A02.STEER_CLEAR","form":"steer clear of","meaningZh":"避开；避免涉及","sense":"习语后接人、事物或doing，本课避免让邻居引起怜悯的图片。不是驾驶方向；可先用avoid表达。","type":"chunk","tier":"support","sceneIds":["S11.A02"],"unitVersion":"pilot-17-0","detailRef":{"path":"./data/releases/pilot-39-0/units/detail-038.c3e78ee86740d302.json","sha256":"c3e78ee86740d302be01051cf1153ff2f7296a02ff9f9f123502ed08e04fdcf9","bytes":96120,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2}},{"id":"U.LEGACY.S11.A02.VANITY","form":"vanity","meaningZh":"虚荣；过分看重自己的形象","sense":"本课过度关注自己姓名与名声的态度，不是浴室洗手柜或徒劳无价值义。识别层，不靠抽象态度列表完成任务。","type":"word","tier":"recognition","sceneIds":["S11.A02"],"unitVersion":"pilot-17-0","detailRef":{"path":"./data/releases/pilot-39-0/units/detail-038.c3e78ee86740d302.json","sha256":"c3e78ee86740d302be01051cf1153ff2f7296a02ff9f9f123502ed08e04fdcf9","bytes":96120,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2}},{"id":"U.LEGACY.S11.A02.MARK","form":"mark … as …","meaningZh":"把……标为……","sense":"mark + 对象 + as + 类别或状态，准确标出费用只是估计，不当作已确认价格。","type":"construction","tier":"core","sceneIds":["S11.A02"],"unitVersion":"pilot-17-0","detailRef":{"path":"./data/releases/pilot-39-0/units/detail-038.c3e78ee86740d302.json","sha256":"c3e78ee86740d302be01051cf1153ff2f7296a02ff9f9f123502ed08e04fdcf9","bytes":96120,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2}},{"id":"U.LEGACY.S11.A02.CONDITION","form":"… can …, but only if …","meaningZh":"可以……，但前提是……","sense":"本课can表示允许这样使用，only if给必要许可条件；不是说故事在没有同意时物理上不能筹到钱。","type":"construction","tier":"core","sceneIds":["S11.A02"],"unitVersion":"pilot-17-0","detailRef":{"path":"./data/releases/pilot-39-0/units/detail-038.c3e78ee86740d302.json","sha256":"c3e78ee86740d302be01051cf1153ff2f7296a02ff9f9f123502ed08e04fdcf9","bytes":96120,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2}},{"id":"U.LEGACY.S05.C01.POTENTIAL_PROMISE","form":"develop inborn potentials","meaningZh":"发掘先天潜能（被引用的宣传承诺）","sense":"识别传单引用的完整承诺。inborn指与生俱来的，potential在人的潜力义中通常不可数；保留来源potentials，不推荐把此复数块当主动输出套句。原中文还提兴趣，英语块并未明确说兴趣。","type":"chunk","tier":"recognition","sceneIds":["S05.C01"],"unitVersion":"pilot-17-0","detailRef":{"path":"./data/releases/pilot-39-0/units/detail-038.c3e78ee86740d302.json","sha256":"c3e78ee86740d302be01051cf1153ff2f7296a02ff9f9f123502ed08e04fdcf9","bytes":96120,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2}},{"id":"U.LEGACY.S05.C01.MASTER_PROMISE","form":"master cutting-edge technology","meaningZh":"熟练掌握前沿技术（被引用的宣传承诺）","sense":"master是及物动词，表示达到熟练掌握程度；cutting-edge在此形容技术处于最新前沿。这个承诺要求的结果超出故事中的一次试用，供识别与改写。","type":"chunk","tier":"recognition","sceneIds":["S05.C01"],"unitVersion":"pilot-17-0","detailRef":{"path":"./data/releases/pilot-39-0/units/detail-038.c3e78ee86740d302.json","sha256":"c3e78ee86740d302be01051cf1153ff2f7296a02ff9f9f123502ed08e04fdcf9","bytes":96120,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2}},{"id":"U.LEGACY.S05.C01.MOTOR_SKILLS","form":"motor skills","meaningZh":"控制身体动作的技能","sense":"本课观察手部动作控制：握笔、调整力度、画线。motor skills是复数名词块；源例句中的fine更具体指小肌肉动作，不把所有运动技能都限为手部。观察运用不证明一次活动已提高技能。","type":"chunk","tier":"core","sceneIds":["S05.C01"],"unitVersion":"pilot-17-0","detailRef":{"path":"./data/releases/pilot-39-0/units/detail-039.535aa0ba5628ce79.json","sha256":"535aa0ba5628ce79673bbffb2064a9f86731514896b929192a1f0a1db5e21629","bytes":25256,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2}},{"id":"U.LEGACY.S05.C01.GRIP","form":"adjusted his grip","meaningZh":"调整了握持方式；本课调整了握笔姿势","sense":"adjust后接要调整的对象；grip在此是手握物件的方式。one's按人物换成his或her；故事adjusted his grip是已发生的动作，不是性格适应或电影工作人员义。","type":"chunk","tier":"core","sceneIds":["S05.C01"],"unitVersion":"pilot-17-0","detailRef":{"path":"./data/releases/pilot-39-0/units/detail-039.535aa0ba5628ce79.json","sha256":"535aa0ba5628ce79673bbffb2064a9f86731514896b929192a1f0a1db5e21629","bytes":25256,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2}},{"id":"U.LEGACY.S05.C01.MOVEMENTS","form":"small, controlled movements","meaningZh":"幅度小且受到控制的动作","sense":"本课描述孩子手部动作，而非对智力作判断。controlled修饰movements，表示动作得到控制；可与握笔和力度这两个可见细节一起说明。","type":"chunk","tier":"support","sceneIds":["S05.C01"],"unitVersion":"pilot-17-0","detailRef":{"path":"./data/releases/pilot-39-0/units/detail-039.535aa0ba5628ce79.json","sha256":"535aa0ba5628ce79673bbffb2064a9f86731514896b929192a1f0a1db5e21629","bytes":25256,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2}},{"id":"U.LEGACY.S05.C01.TRY_TOOL","form":"try a digital tool with guidance","meaningZh":"在指导下尝试一个数字工具","sense":"try说明体验动作，with guidance说明提供帮助的条件。能试用一种工具与已经熟练掌握技术的范围不同；本故事实际提供的是志愿者的指导。","type":"chunk","tier":"core","sceneIds":["S05.C01"],"unitVersion":"pilot-17-0","detailRef":{"path":"./data/releases/pilot-39-0/units/detail-039.535aa0ba5628ce79.json","sha256":"535aa0ba5628ce79673bbffb2064a9f86731514896b929192a1f0a1db5e21629","bytes":25256,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2}},{"id":"U.LEGACY.S05.C01.GUIDANCE","form":"with guidance","meaningZh":"在指导下","sense":"with + guidance说明开展活动时有建议或帮助。guidance通常不可数；这里来自志愿者，不表示单靠提供帮助就保证学习结果。","type":"chunk","tier":"support","sceneIds":["S05.C01","S05.C02"],"unitVersion":"pilot-17-0","detailRef":{"path":"./data/releases/pilot-39-0/units/detail-039.535aa0ba5628ce79.json","sha256":"535aa0ba5628ce79673bbffb2064a9f86731514896b929192a1f0a1db5e21629","bytes":25256,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2}},{"id":"U.LEGACY.S05.C01.CONDITION","form":"… may … if …","meaningZh":"表达依赖条件的可能性","sense":"may后接动词原形，if后说明尚须满足的条件。这里给家长一个有限看法；可能获益不等于已经证明有效。","type":"construction","tier":"core","sceneIds":["S05.C01"],"unitVersion":"pilot-17-0","detailRef":{"path":"./data/releases/pilot-39-0/units/detail-039.535aa0ba5628ce79.json","sha256":"535aa0ba5628ce79673bbffb2064a9f86731514896b929192a1f0a1db5e21629","bytes":25256,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2}},{"id":"U.LEGACY.S05.C02.COGNITIVE","form":"cognitive development","meaningZh":"认知发展；思考与理解方式的发展","sense":"讨论儿童思考和理解逐渐变化的过程。cognitive修饰development；本课用它命名讨论主题，不从画线更直断定课程造成认知发展，也不把它与手部动作技能混成一项。","type":"chunk","tier":"core","sceneIds":["S05.C02"],"unitVersion":"pilot-17-0","detailRef":{"path":"./data/releases/pilot-39-0/units/detail-039.535aa0ba5628ce79.json","sha256":"535aa0ba5628ce79673bbffb2064a9f86731514896b929192a1f0a1db5e21629","bytes":25256,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2}},{"id":"U.LEGACY.S05.C02.ERUDITE","form":"erudite","meaningZh":"博学的；有深厚学识的（正式）","sense":"形容词，可描述人或其作品展示出深厚学识。这里故事已把教授描述为博学；书多本身不构成判定学识的标准。放在识别层，不因其学识就把意见当成因果证据。","type":"word","tier":"recognition","sceneIds":["S05.C02"],"unitVersion":"pilot-17-0","detailRef":{"path":"./data/releases/pilot-39-0/units/detail-039.535aa0ba5628ce79.json","sha256":"535aa0ba5628ce79673bbffb2064a9f86731514896b929192a1f0a1db5e21629","bytes":25256,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2}},{"id":"U.LEGACY.S05.C02.OVER_TIME","form":"over time","meaningZh":"随着时间推移","sense":"整块说明逐渐变化的时间范围。本课把儿童的长期变化与一次到访区分；它不保证随着时间过去就一定有好效果。不要把over按移交物件来逐词理解。","type":"chunk","tier":"core","sceneIds":["S05.C02"],"unitVersion":"pilot-17-0","detailRef":{"path":"./data/releases/pilot-39-0/units/detail-039.535aa0ba5628ce79.json","sha256":"535aa0ba5628ce79673bbffb2064a9f86731514896b929192a1f0a1db5e21629","bytes":25256,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2}},{"id":"U.LEGACY.S05.C02.OBSERVATION","form":"one observation","meaningZh":"一次观察；一项观察所得","sense":"在本课中指看见某项具体表现所得的观察信息。它可以引出问题，不能独自排除家庭练习等其他原因；不是已完成的完整科学实验。","type":"chunk","tier":"core","sceneIds":["S05.C02"],"unitVersion":"pilot-17-0","detailRef":{"path":"./data/releases/pilot-39-0/units/detail-039.535aa0ba5628ce79.json","sha256":"535aa0ba5628ce79673bbffb2064a9f86731514896b929192a1f0a1db5e21629","bytes":25256,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2}},{"id":"U.LEGACY.S05.C02.CAUSE","form":"cause","meaningZh":"导致；引起","sense":"本课及物动词，cause a change或cause + 名词。故事caused是过去式；否定句表示目前画作没有证明因果，不表示课程被证明完全没有作用。","type":"word","tier":"support","sceneIds":["S05.C02"],"unitVersion":"pilot-17-0","detailRef":{"path":"./data/releases/pilot-39-0/units/detail-039.535aa0ba5628ce79.json","sha256":"535aa0ba5628ce79673bbffb2064a9f86731514896b929192a1f0a1db5e21629","bytes":25256,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2}},{"id":"U.LEGACY.S05.C02.PATIENT","form":"patient","meaningZh":"耐心的","sense":"形容词修饰guidance，描述指导者耐心帮助的方式。与诊所已有patients病人名词义分开；耐心指导是条件，不能直接当成效果已被证实。","type":"word","tier":"support","sceneIds":["S05.C02"],"unitVersion":"pilot-17-0","detailRef":{"path":"./data/releases/pilot-39-0/units/detail-039.535aa0ba5628ce79.json","sha256":"535aa0ba5628ce79673bbffb2064a9f86731514896b929192a1f0a1db5e21629","bytes":25256,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2}},{"id":"U.LEGACY.S05.C02.NEXT_STEP","form":"talk about a next step","meaningZh":"谈一谈下一步行动","sense":"talk about后说讨论对象；a next step指一个可继续做的具体行动。这里邀请家长和孩子谈下一步，之后是否返回由家长判断，不把下一步说成命运预测。","type":"chunk","tier":"core","sceneIds":["S05.C02"],"unitVersion":"pilot-17-0","detailRef":{"path":"./data/releases/pilot-39-0/units/detail-039.535aa0ba5628ce79.json","sha256":"535aa0ba5628ce79673bbffb2064a9f86731514896b929192a1f0a1db5e21629","bytes":25256,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2}}],"resources":[{"path":"./data/releases/pilot-39-0/units/detail-037.5c59f667efa2b30d.json","sha256":"5c59f667efa2b30d9e130bafa94f6ddbba21abc8eacac2a79a71ae7e1acd84e2","bytes":97862,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2},{"path":"./data/releases/pilot-39-0/units/detail-038.c3e78ee86740d302.json","sha256":"c3e78ee86740d302be01051cf1153ff2f7296a02ff9f9f123502ed08e04fdcf9","bytes":96120,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2},{"path":"./data/releases/pilot-39-0/units/detail-039.535aa0ba5628ce79.json","sha256":"535aa0ba5628ce79673bbffb2064a9f86731514896b929192a1f0a1db5e21629","bytes":25256,"kind":"unit-details","release":"pilot-39-0","schemaVersion":2}]}
