{"schemaVersion":2,"release":"pilot-39-0","kind":"dictionary-translations","data":{"s:00910101":{"examples":{"a flat desk":"一张桌面平坦的书桌"}},"n:06647206":{"examples":{"the film provided a valuable record of stage techniques":"这部影片留下了有关舞台技巧的宝贵记录。"}},"n:04344246":{"examples":{"she ran a dance studio":"她经营了一间舞蹈工作室。"}},"n:06689297":{"examples":{"he asked permission to leave":"他请求允许离开。"}},"v:00715239":{"examples":{"I feel that he doesn't like me":"我觉得他不喜欢我。","I find him to be obnoxious":"我觉得他很讨厌。","I found the movie rather entertaining":"我觉得这部电影相当有趣。"}},"n:03485997":{"examples":{"he grabbed the hammer by the handle":"他抓住了锤子的柄。","it was an old briefcase but it still had a good grip":"那是一个旧公文包，但提手仍很好用。"}},"s:01496592":{"examples":{"the fee was nominal":"收费微乎其微","a token gesture of resistance":"象征性的抵抗姿态","a toknenish gesture":"象征性的姿态（原句的toknenish疑有拼写错误，英文照录）"}},"a:02052333":{"examples":{"urban property owners":"城市房产业主","urban affairs":"城市事务","urban manners":"城市人的举止"}},"v:00357332":{"examples":{"the potatoes sprouted":"土豆发芽了。"}},"n:03208556":{"examples":{}},"n:09375085":{"examples":{}},"s:01287808":{"examples":{"walked with a marked limp":"走路时明显跛行。","a pronounced flavor of cinnamon":"明显的肉桂味。"}},"v:02619924":{"examples":{"He survived the cancer against all odds":"尽管机会渺茫，他仍在患癌后活了下来。"}}},"resources":[]}
