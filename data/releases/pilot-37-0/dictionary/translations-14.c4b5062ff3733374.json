{"schemaVersion":2,"release":"pilot-37-0","kind":"dictionary-translations","data":{"n:04928903":{"examples":{"her dignified manner":"她庄重的举止","his rapid manner of talking":"他快速说话的方式","their nomadic mode of existence":"他们游牧式的生活方式","in the characteristic New York style":"以纽约特有的风格","a lonely way of life":"孤独的生活方式","in an abrasive fashion":"以粗鲁刺人的方式"}},"v:01332730":{"examples":{"cover her face with a handkerchief":"用手帕盖住她的脸。","cover the child with a blanket":"用毯子盖住那个孩子。","cover the grave with flowers":"用鲜花覆盖那座坟墓。"}},"s:02465115":{"examples":{"an authentic account by an eyewitness":"目击者提供的符合事实的叙述","reliable information":"可靠的信息"}},"s:00494409":{"examples":{"the respective club members":"各个俱乐部各自的会员","specialists in their several fields":"各个领域里的专家","the various reports all agreed":"各份报告都意见一致"}},"r:00035058":{"examples":{"we often met over a cup of coffee":"我们常常一起喝咖啡、见面聊天"}},"n:00331950":{"examples":{"the reflex motion of his eyebrows revealed his surprise":"他眉毛的本能动作显露出惊讶","movement is a sign of life":"运动是生命的迹象","an impatient move of his hand":"他手上一个不耐烦的动作","gastrointestinal motility":"胃肠蠕动"}},"s:00250119":{"examples":{"audacious explorers":"大胆的探险者","fearless reporters and photographers":"无畏的记者与摄影师","intrepid pioneers":"勇敢无畏的先驱者"}},"n:05624042":{"examples":{}},"v:00771961":{"examples":{"She prompted me to call my relatives":"她促使我给亲戚打电话。"}},"a:00329396":{"examples":{}}},"resources":[]}
