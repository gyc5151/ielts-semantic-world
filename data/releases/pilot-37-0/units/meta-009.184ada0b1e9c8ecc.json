{"schemaVersion":2,"release":"pilot-37-0","kind":"unit-meta","data":[{"id":"U.LEGACY.S05.C01.MOVEMENTS","form":"small, controlled movements","meaningZh":"幅度小且受到控制的动作","sense":"本课描述孩子手部动作，而非对智力作判断。controlled修饰movements，表示动作得到控制；可与握笔和力度这两个可见细节一起说明。","type":"chunk","tier":"support","sceneIds":["S05.C01"],"unitVersion":"pilot-17-0","detailRef":{"path":"./data/releases/pilot-37-0/units/detail-032.b9537787c7e56a06.json","sha256":"b9537787c7e56a06c433be9bdc7e777d3457167c89a5bfaf1f326dbf291dd484","bytes":25256,"kind":"unit-details","release":"pilot-37-0","schemaVersion":2}},{"id":"U.LEGACY.S05.C01.TRY_TOOL","form":"try a digital tool with guidance","meaningZh":"在指导下尝试一个数字工具","sense":"try说明体验动作，with guidance说明提供帮助的条件。能试用一种工具与已经熟练掌握技术的范围不同；本故事实际提供的是志愿者的指导。","type":"chunk","tier":"core","sceneIds":["S05.C01"],"unitVersion":"pilot-17-0","detailRef":{"path":"./data/releases/pilot-37-0/units/detail-032.b9537787c7e56a06.json","sha256":"b9537787c7e56a06c433be9bdc7e777d3457167c89a5bfaf1f326dbf291dd484","bytes":25256,"kind":"unit-details","release":"pilot-37-0","schemaVersion":2}},{"id":"U.LEGACY.S05.C01.GUIDANCE","form":"with guidance","meaningZh":"在指导下","sense":"with + guidance说明开展活动时有建议或帮助。guidance通常不可数；这里来自志愿者，不表示单靠提供帮助就保证学习结果。","type":"chunk","tier":"support","sceneIds":["S05.C01","S05.C02"],"unitVersion":"pilot-17-0","detailRef":{"path":"./data/releases/pilot-37-0/units/detail-032.b9537787c7e56a06.json","sha256":"b9537787c7e56a06c433be9bdc7e777d3457167c89a5bfaf1f326dbf291dd484","bytes":25256,"kind":"unit-details","release":"pilot-37-0","schemaVersion":2}},{"id":"U.LEGACY.S05.C01.CONDITION","form":"… may … if …","meaningZh":"表达依赖条件的可能性","sense":"may后接动词原形，if后说明尚须满足的条件。这里给家长一个有限看法；可能获益不等于已经证明有效。","type":"construction","tier":"core","sceneIds":["S05.C01"],"unitVersion":"pilot-17-0","detailRef":{"path":"./data/releases/pilot-37-0/units/detail-032.b9537787c7e56a06.json","sha256":"b9537787c7e56a06c433be9bdc7e777d3457167c89a5bfaf1f326dbf291dd484","bytes":25256,"kind":"unit-details","release":"pilot-37-0","schemaVersion":2}},{"id":"U.LEGACY.S05.C02.COGNITIVE","form":"cognitive development","meaningZh":"认知发展；思考与理解方式的发展","sense":"讨论儿童思考和理解逐渐变化的过程。cognitive修饰development；本课用它命名讨论主题，不从画线更直断定课程造成认知发展，也不把它与手部动作技能混成一项。","type":"chunk","tier":"core","sceneIds":["S05.C02"],"unitVersion":"pilot-17-0","detailRef":{"path":"./data/releases/pilot-37-0/units/detail-032.b9537787c7e56a06.json","sha256":"b9537787c7e56a06c433be9bdc7e777d3457167c89a5bfaf1f326dbf291dd484","bytes":25256,"kind":"unit-details","release":"pilot-37-0","schemaVersion":2}},{"id":"U.LEGACY.S05.C02.ERUDITE","form":"erudite","meaningZh":"博学的；有深厚学识的（正式）","sense":"形容词，可描述人或其作品展示出深厚学识。这里故事已把教授描述为博学；书多本身不构成判定学识的标准。放在识别层，不因其学识就把意见当成因果证据。","type":"word","tier":"recognition","sceneIds":["S05.C02"],"unitVersion":"pilot-17-0","detailRef":{"path":"./data/releases/pilot-37-0/units/detail-032.b9537787c7e56a06.json","sha256":"b9537787c7e56a06c433be9bdc7e777d3457167c89a5bfaf1f326dbf291dd484","bytes":25256,"kind":"unit-details","release":"pilot-37-0","schemaVersion":2}},{"id":"U.LEGACY.S05.C02.OVER_TIME","form":"over time","meaningZh":"随着时间推移","sense":"整块说明逐渐变化的时间范围。本课把儿童的长期变化与一次到访区分；它不保证随着时间过去就一定有好效果。不要把over按移交物件来逐词理解。","type":"chunk","tier":"core","sceneIds":["S05.C02"],"unitVersion":"pilot-17-0","detailRef":{"path":"./data/releases/pilot-37-0/units/detail-032.b9537787c7e56a06.json","sha256":"b9537787c7e56a06c433be9bdc7e777d3457167c89a5bfaf1f326dbf291dd484","bytes":25256,"kind":"unit-details","release":"pilot-37-0","schemaVersion":2}},{"id":"U.LEGACY.S05.C02.OBSERVATION","form":"one observation","meaningZh":"一次观察；一项观察所得","sense":"在本课中指看见某项具体表现所得的观察信息。它可以引出问题，不能独自排除家庭练习等其他原因；不是已完成的完整科学实验。","type":"chunk","tier":"core","sceneIds":["S05.C02"],"unitVersion":"pilot-17-0","detailRef":{"path":"./data/releases/pilot-37-0/units/detail-032.b9537787c7e56a06.json","sha256":"b9537787c7e56a06c433be9bdc7e777d3457167c89a5bfaf1f326dbf291dd484","bytes":25256,"kind":"unit-details","release":"pilot-37-0","schemaVersion":2}},{"id":"U.LEGACY.S05.C02.CAUSE","form":"cause","meaningZh":"导致；引起","sense":"本课及物动词，cause a change或cause + 名词。故事caused是过去式；否定句表示目前画作没有证明因果，不表示课程被证明完全没有作用。","type":"word","tier":"support","sceneIds":["S05.C02"],"unitVersion":"pilot-17-0","detailRef":{"path":"./data/releases/pilot-37-0/units/detail-032.b9537787c7e56a06.json","sha256":"b9537787c7e56a06c433be9bdc7e777d3457167c89a5bfaf1f326dbf291dd484","bytes":25256,"kind":"unit-details","release":"pilot-37-0","schemaVersion":2}},{"id":"U.LEGACY.S05.C02.PATIENT","form":"patient","meaningZh":"耐心的","sense":"形容词修饰guidance，描述指导者耐心帮助的方式。与诊所已有patients病人名词义分开；耐心指导是条件，不能直接当成效果已被证实。","type":"word","tier":"support","sceneIds":["S05.C02"],"unitVersion":"pilot-17-0","detailRef":{"path":"./data/releases/pilot-37-0/units/detail-032.b9537787c7e56a06.json","sha256":"b9537787c7e56a06c433be9bdc7e777d3457167c89a5bfaf1f326dbf291dd484","bytes":25256,"kind":"unit-details","release":"pilot-37-0","schemaVersion":2}},{"id":"U.LEGACY.S05.C02.NEXT_STEP","form":"talk about a next step","meaningZh":"谈一谈下一步行动","sense":"talk about后说讨论对象；a next step指一个可继续做的具体行动。这里邀请家长和孩子谈下一步，之后是否返回由家长判断，不把下一步说成命运预测。","type":"chunk","tier":"core","sceneIds":["S05.C02"],"unitVersion":"pilot-17-0","detailRef":{"path":"./data/releases/pilot-37-0/units/detail-032.b9537787c7e56a06.json","sha256":"b9537787c7e56a06c433be9bdc7e777d3457167c89a5bfaf1f326dbf291dd484","bytes":25256,"kind":"unit-details","release":"pilot-37-0","schemaVersion":2}}],"resources":[{"path":"./data/releases/pilot-37-0/units/detail-032.b9537787c7e56a06.json","sha256":"b9537787c7e56a06c433be9bdc7e777d3457167c89a5bfaf1f326dbf291dd484","bytes":25256,"kind":"unit-details","release":"pilot-37-0","schemaVersion":2}]}
